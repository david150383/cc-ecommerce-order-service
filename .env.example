NODE_ENV=development
PORT=4004
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# Shared local stack (ecommerce-infrastructure: docker compose up -d):
MONGODB_URI=mongodb://order_svc:order_local_pw@localhost:27017/order_db?authSource=order_db
# Standalone (this repo: docker compose up -d):
# MONGODB_URI=mongodb://localhost:27018/order_db
# Integration tests drop and recreate this database:
TEST_MONGODB_URI=mongodb://root:mongo_local_admin@localhost:27017/order_test?authSource=admin

# Incoming tokens
JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_SERVICE_AUDIENCE=ecommerce-order-service

# Outgoing: client-credentials grant at Auth, then Product's price lookup.
AUTH_SERVICE_URL=http://localhost:4001
SERVICE_CLIENT_ID=ecommerce-order-service
SERVICE_CLIENT_SECRET=order-service-local-secret   # LOCAL ONLY; production value from Secrets Manager
PRODUCT_SERVICE_URL=http://localhost:4002
DEPENDENCY_TIMEOUT_MS=3000

# Pricing policy
SUPPORTED_CURRENCIES=INR
TAX_RATE_BPS=1800
SHIPPING_FEE_MINOR=4900
FREE_SHIPPING_THRESHOLD_MINOR=99900
COUPONS=[{"code":"WELCOME10","percentBps":1000,"maxDiscountMinor":50000}]
