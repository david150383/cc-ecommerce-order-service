{
  "openapi": "3.1.0",
  "info": {
    "title": "Order Service",
    "version": "1.0.0",
    "description": "Orders, price snapshots and the order lifecycle. Semantics: docs/api.md"
  },
  "servers": [
    {
      "url": "http://localhost:4004"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "OrderResponse": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          }
        },
        "required": [
          "order"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "INVENTORY_RESERVING",
              "INVENTORY_RESERVED",
              "PAYMENT_PENDING",
              "PAYMENT_PROCESSING",
              "PAYMENT_SUCCEEDED",
              "CONFIRMED",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLATION_PENDING",
              "CANCELLED",
              "FAILED",
              "REFUND_PENDING",
              "REFUNDED"
            ]
          },
          "currency": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string"
                },
                "productId": {
                  "type": "string"
                },
                "variantId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "unitPrice": {
                  "$ref": "#/components/schemas/Money"
                },
                "lineSubtotal": {
                  "$ref": "#/components/schemas/Money"
                },
                "discount": {
                  "$ref": "#/components/schemas/Money"
                },
                "tax": {
                  "$ref": "#/components/schemas/Money"
                },
                "lineTotal": {
                  "$ref": "#/components/schemas/Money"
                }
              },
              "required": [
                "sku",
                "productId",
                "variantId",
                "name",
                "quantity",
                "unitPrice",
                "lineSubtotal",
                "discount",
                "tax",
                "lineTotal"
              ]
            }
          },
          "totals": {
            "type": "object",
            "properties": {
              "subtotal": {
                "$ref": "#/components/schemas/Money"
              },
              "discount": {
                "$ref": "#/components/schemas/Money"
              },
              "tax": {
                "$ref": "#/components/schemas/Money"
              },
              "shipping": {
                "$ref": "#/components/schemas/Money"
              },
              "grandTotal": {
                "$ref": "#/components/schemas/Money"
              }
            },
            "required": [
              "subtotal",
              "discount",
              "tax",
              "shipping",
              "grandTotal"
            ]
          },
          "taxRateBps": {
            "type": "integer"
          },
          "couponCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddress"
          },
          "sagaId": {
            "type": [
              "string",
              "null"
            ]
          },
          "cancellationReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "statusHistory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "from",
                "to",
                "reason",
                "actor",
                "at"
              ]
            }
          },
          "version": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "currency",
          "items",
          "totals",
          "taxRateBps",
          "couponCode",
          "shippingAddress",
          "sagaId",
          "cancellationReason",
          "statusHistory",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ]
      },
      "ShippingAddress": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "line1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "line2": {
            "type": "string",
            "maxLength": 200
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "state": {
            "type": "string",
            "maxLength": 100
          },
          "postalCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{6,14}$"
          }
        },
        "required": [
          "name",
          "line1",
          "city",
          "postalCode",
          "country",
          "phone"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance"
        ],
        "additionalProperties": {}
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "sagaId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              },
              "required": [
                "sku",
                "quantity"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddress"
          },
          "couponCode": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "customerId",
          "currency",
          "items",
          "shippingAddress"
        ],
        "additionalProperties": false,
        "description": "Sent by the Saga Orchestrator. Prices and totals are NOT accepted: they are looked up."
      },
      "OrderPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "page": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer"
              },
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "limit",
              "nextCursor"
            ]
          }
        },
        "required": [
          "data",
          "page"
        ]
      },
      "FulfillmentRequest": {
        "type": "object",
        "properties": {
          "toStatus": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "SHIPPED",
              "DELIVERED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "toStatus",
          "reason"
        ],
        "additionalProperties": false
      },
      "InternalOrderView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "INVENTORY_RESERVING",
              "INVENTORY_RESERVED",
              "PAYMENT_PENDING",
              "PAYMENT_PROCESSING",
              "PAYMENT_SUCCEEDED",
              "CONFIRMED",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLATION_PENDING",
              "CANCELLED",
              "FAILED",
              "REFUND_PENDING",
              "REFUNDED"
            ]
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "total",
          "version"
        ]
      },
      "TransitionRequest": {
        "type": "object",
        "properties": {
          "toStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "INVENTORY_RESERVING",
              "INVENTORY_RESERVED",
              "PAYMENT_PENDING",
              "PAYMENT_PROCESSING",
              "PAYMENT_SUCCEEDED",
              "CONFIRMED",
              "PROCESSING",
              "SHIPPED",
              "DELIVERED",
              "CANCELLATION_PENDING",
              "CANCELLED",
              "FAILED",
              "REFUND_PENDING",
              "REFUNDED"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cancellationReason": {
            "type": "string",
            "enum": [
              "OUT_OF_STOCK",
              "PAYMENT_FAILED",
              "PAYMENT_TIMEOUT",
              "CUSTOMER_REQUESTED",
              "ADMIN",
              "SYSTEM"
            ]
          }
        },
        "required": [
          "toStatus",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/orders": {
      "post": {
        "tags": [
          "orders"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create a PENDING order (service token: Saga Orchestrator). Prices are looked up, never accepted.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replayed (Idempotency-Replayed: true)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED / IDEMPOTENCY_KEY_REQUIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "FORBIDDEN",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "PRODUCT_UNAVAILABLE, CURRENCY_MISMATCH, UNSUPPORTED_CURRENCY, INVALID_COUPON, IDEMPOTENCY_KEY_REUSED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "DEPENDENCY_UNAVAILABLE (Product or Auth unreachable)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "orders"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Orders: customers get their own, admins get all (cursor pagination, newest first)",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/my-orders": {
      "get": {
        "tags": [
          "orders"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "The caller's own orders",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{orderId}": {
      "get": {
        "tags": [
          "orders"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Order detail (owner or admin; others get 404)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "orderId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{orderId}/cancel": {
      "post": {
        "tags": [
          "orders"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Cancel before payment, or request cancellation after payment (idempotent)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "orderId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Cancelled or CANCELLATION_PENDING",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "409": {
            "description": "CANNOT_CANCEL",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/orders": {
      "get": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Search all orders (admin)",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "INVENTORY_RESERVING",
                "INVENTORY_RESERVED",
                "PAYMENT_PENDING",
                "PAYMENT_PROCESSING",
                "PAYMENT_SUCCEEDED",
                "CONFIRMED",
                "PROCESSING",
                "SHIPPED",
                "DELIVERED",
                "CANCELLATION_PENDING",
                "CANCELLED",
                "FAILED",
                "REFUND_PENDING",
                "REFUNDED"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "customerId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "createdFrom",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "name": "createdTo",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/orders/{orderId}/status": {
      "patch": {
        "tags": [
          "admin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Fulfillment: PROCESSING, SHIPPED, DELIVERED (admin)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "orderId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FulfillmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "409": {
            "description": "INVALID_TRANSITION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/orders/{orderId}": {
      "get": {
        "tags": [
          "internal"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Authoritative amount and owner (service token)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "orderId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Order summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalOrderView"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/v1/orders/{orderId}/transitions": {
      "post": {
        "tags": [
          "internal"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Saga-driven status change (service token); idempotent",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "orderId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied or already in that status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order": {},
                    "changed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "changed"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "INVALID_TRANSITION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
